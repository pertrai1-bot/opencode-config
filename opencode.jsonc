{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "opencode/kimi-k2.5",
  "default_agent": "plan",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  
  // 1. Core Discovery Routes
  // Links your custom skills and rule folders to OpenCode for auto-discovery
  "skills": [
    "./skills"
  ],
  "instructions": [
    "rules/**/*.md",
    "context/**/*.md",
    "profiles/**/*.md"
  ],

  // 2. Conversation & Cost Guardrails
  // Drastically cuts down token usage and limits long terminal/agent outputs
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 10240
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "keep": {
      "turns": 4,
      "tokens": 4000
    },
    "buffer": 8000
  },

  // 3. Recommended Plugins for Cost and Token Analysis
  "plugins": [
    "opencode-cost-guard",   // Halts/warns if the session spending goes past a designated threshold
    "opencode-tokenscope"    // Provides a visual distribution breakdown of where tokens went
  ],

  // 4. Global Tool Permissions
  "permission": {
    "doom_loop": "deny"
  },

  // 5. Configured SDLC Agents
  "agent": {
    "build": {
      "model": "openai/gpt-5.5",
      "temperature": 0.2,
      "permission": {
        "doom_loop": "deny",
        "edit": "allow",
        
        // Comprehensive shell patterns allowed automatically to prevent frequent popups
        "bash": {
          // Standard wildcard fallback - asks for high-risk operations (e.g. rm, curl, sudo)
          "*": "ask",
          
          // Repository Observation and Git Management
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git add*": "allow",
          "git checkout*": "allow",
          "git restore*": "allow",
          "git commit*": "allow",
          "git clean --dry-run*": "allow",
          "git clean -n*": "allow",
          
          // Basic Navigation and Information Retrieval
          "ls": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "wc *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          
          // Dependency Management (TypeScript/Node JS Stack)
          "npm install*": "allow",
          "yarn install*": "allow",
          "bun install*": "allow",
          "pnpm install*": "allow",
          
          // Build and Compiler Execution
          "npm run build*": "allow",
          "bun run build*": "allow",
          "npm run compile*": "allow",
          "npx tsc*": "allow",
          "tsc*": "allow",
          
          // Test Suites Execution
          "npm test*": "allow",
          "npm run test*": "allow",
          "bun test*": "allow",
          "jest*": "allow",
          "vitest*": "allow",
          
          // Linter and Formatter Execution (Biome, ESLint, Prettier)
          "npm run lint*": "allow",
          "npm run format*": "allow",
          "bun run check*": "allow",
          "bun run lint*": "allow",
          "biome check*": "allow",
          "biome lint*": "allow",
          "biome format*": "allow",
          "eslint*": "allow",
          "npx eslint*": "allow",
          "npx prettier*": "allow"
        }
      }
    },
    "plan": {
      "model": "opencode/kimi-k2.5"
    }
  },

  // 6. Registered Model Context Protocol (MCP) Servers
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.2.2"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus", "mcp"],
      "enabled": true
    }
  }
}
